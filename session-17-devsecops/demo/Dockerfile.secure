# Hardened image for the Session 17 DevSecOps pipeline.
# Differences from the course Dockerfile:
#   - OS packages upgraded at build time (fixes CVEs that Trivy reports as "fixed")
#   - runs as a non-root user (uid 10001)
#   - served by gunicorn, so app.run(debug=True) in app/app.py is never executed
#   - OCI label links the GHCR package to the GitHub repository
FROM python:3.12-slim

LABEL org.opencontainers.image.source="https://github.com/devops-student/devops-heros" \
      org.opencontainers.image.description="Session 17 DevSecOps demo (Flask + gunicorn)" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
 && apt-get upgrade -y \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin appuser

COPY requirements.txt requirements-prod.txt ./
RUN pip install -r requirements-prod.txt

COPY app ./app

USER 10001

EXPOSE 5001

CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--workers", "2", "--worker-tmp-dir", "/tmp", "--access-logfile", "-", "app.app:app"]
