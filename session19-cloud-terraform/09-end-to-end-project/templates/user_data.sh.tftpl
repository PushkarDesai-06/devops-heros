#!/bin/bash
# EC2 bootstrap for the Session 19 web server (Amazon Linux 2023).
# Rendered by Terraform templatefile(): project_name and aws_region are filled in at plan time.
set -euxo pipefail

dnf install -y nginx

TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)

cat > /usr/share/nginx/html/index.html <<HTML
<!doctype html>
<html>
<head><title>${project_name}</title></head>
<body>
  <h1>Hello from ${project_name}</h1>
  <p>Provisioned by Terraform in ${aws_region}.</p>
  <p>Instance: $INSTANCE_ID ($AZ)</p>
</body>
</html>
HTML

systemctl enable --now nginx
